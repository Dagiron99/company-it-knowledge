allowHtml: false
ignore:
  - .catalog-git/**
  - _site/**
  - node_modules/**
  - .venv/**
  - dist/**
extensions:
  - ./extensions/mermaid.cjs
search:
  enabled: true
  provider: local
  tolerance: 1
  confidence: sparsed
docs-viewer:
  lang: ru
  langs:
    - ru
  project-name: IT Knowledge Catalog
